#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define COLEMAK 1
#define SYM     2
#define ARROWS  3
#define NUM     4
#define FUN     5
#define WINDOW  6
#define ADJUST  7

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <5 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp LC(A)  &kp LC(K_UNDO)  &kp LC(C)  &kp LC(V)  &sl 7                              &kp HOME  &kp LEFT   &kp RIGHT  &kp END   &kp TAB   &kp GRAVE
&kp ESC    &kp Q      &kp W           &kp E      &kp R      &kp T      &kp Y                             &kp U      &kp I      &kp O     &kp P     &kp SQT
&kp TAB    &kp A      &kp S           &kp D      &kp F      &kp G      &kp H                             &kp J      &kp K      &kp L     &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z      &kp X           &kp C      &kp V      &kp B      &kp C_MUTE  &kp C_PLAY  &kp N     &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                      &kp LGUI        &kp LALT   &kp LCTRL  &kp SPACE  &mo 3       &mo 2       &kp BSPC  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        colemak {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp B   &kp J                   &kp L   &kp U      &kp Y    &kp SEMI  &kp APOS
&trans  &kp A   &kp R   &kp S   &kp T   &kp G   &kp M                   &kp N   &kp E      &kp I    &kp O     &kp ENTER
&trans  &kp Z   &kp X   &kp C   &kp D   &kp V   &trans  &trans  &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans
            >;
        };

        sym {
            bindings = <
&none  &none            &none          &none             &none      &none                           &none   &none                 &none                  &none         &none              &studio_unlock
&none  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS  &kp RSHFT    &kp CARET                  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LS(DLLR)  &none              &none
&none  &kp EXCLAMATION  &kp STAR       &kp FSLH          &kp EQUAL  &kp AMPS     &kp HASH                   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI      &kp DOUBLE_QUOTES  &none
&none  &kp TILDE        &kp PLUS       &kp LBKT          &kp RBKT   &kp PERCENT  &none      &none   &kp AT  &kp COLON             &kp COMMA              &kp DOT       &kp LSHFT          &none
                        &none          &none             &none      &mo 4        &none      &trans  &none   &none                 &none                  &none
            >;
        };

        arrows {
            display-name = "arrows";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &none  &none         &none     &none          &none    &none
&none  &kp INS       &kp PSCRN     &kp K_CMENU   &none         &none           &kp PG_UP                &kp LC(LEFT)  &kp UP    &kp LC(RIGHT)  &kp N0   &none
&none  &kp LALT      &kp LCTRL     &kp LSHFT     &none         &kp CLCK        &kp PG_DN                &kp LEFT      &kp DOWN  &kp RIGHT      &kp DEL  &kp BSPC
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &studio_unlock  &none      &none  &none  &kp HOME      &none     &kp END        &none    &none
                     &none         &none         &none         &none           &mo 3      &sl 7  &none  &none         &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        num {
            bindings = <
&none  &none      &kp N0  &kp N0  &kp N0  &none                      &none  &none  &none  &none  &none  &none
&none  &kp FSLH   &kp N9  &kp N8  &kp N7  &kp STAR     &none                &none  &none  &none  &none  &none
&none  &kp MINUS  &kp N3  &kp N2  &kp N1  &kp PLUS     &none                &none  &none  &none  &none  &none
&none  &none      &kp N6  &kp N5  &kp N4  &kp PERCENT  &none  &none  &none  &none  &none  &none  &none  &none
                  &none   &none   &none   &mo 4        &none  &mo 2  &none  &none  &none  &none
            >;
        };

        fun {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F12  &kp F9  &kp F8  &kp F7  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F3  &kp F2  &kp F1  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        window {
            bindings = <
&none  &none  &none                &none                &none                &none                    &none  &none            &none        &none  &none  &none
&none  &none  &none                &none                &none                &none      &none                &none            &none        &none  &none  &none
&none  &none  &kp LG(KP_NUMBER_3)  &kp LG(KP_NUMBER_2)  &kp LG(KP_N1)        &kp LG(D)  &none                &none            &none        &none  &none  &none
&none  &none  &kp LG(KP_NUMBER_6)  &kp LG(KP_NUMBER_5)  &kp LG(KP_NUMBER_4)  &none      &none  &none  &none  &kp LS(LA(TAB))  &kp LA(TAB)  &none  &none  &none
              &none                &none                &none                &none      &none  &none  &none  &none            &none        &none
            >;
        };

        adjust {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                             &none  &none  &none  &none  &none  &tog 1
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none                          &none  &none  &none  &none  &tog 0
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &none                          &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG  &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none            &none  &none  &none  &none  &none
            >;
        };
    };
};
